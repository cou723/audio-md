{
  "name": "audionote",
  "displayName": "Audio Note Viewer",
  "description": "View .audionote.md files with synchronized audio playback",
  "version": "0.1.0",
  "publisher": "cou723",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "audionote.openPreview",
        "title": "Open Audio Note Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "audionote.openPreview",
          "when": "resourceFilename =~ /\\.audionote\\.md$/",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "effect": "^3.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
