{
  "name": "audio-md",
  "displayName": "AudioMD",
  "description": "View .audionote.md and .audiomd.md files with synchronized audio playback",
  "version": "0.2.1",
  "publisher": "dpv-caesar-1",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cou723/audio-md.git"
  },
  "bugs": {
    "url": "https://github.com/cou723/audio-md/issues"
  },
  "homepage": "https://github.com/cou723/audio-md#readme",
  "keywords": [
    "audio",
    "markdown",
    "waveform",
    "transcription",
    "note"
  ],
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "audio-md.seekBackward",
        "title": "Seek Backward 5 Seconds",
        "category": "AudioMD"
      },
      {
        "command": "audio-md.togglePlayback",
        "title": "Toggle Playback",
        "category": "AudioMD"
      },
      {
        "command": "audio-md.seekForward",
        "title": "Seek Forward 5 Seconds",
        "category": "AudioMD"
      },
      {
        "command": "audio-md.insertCurrentTimestamp",
        "title": "Insert Current Timestamp",
        "category": "AudioMD"
      },
      {
        "command": "audio-md.openPreview",
        "title": "Open AudioMD Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "audio-md.migrateAudioReference",
        "title": "Migrate Legacy Audio Reference",
        "category": "AudioMD",
        "enablement": "resourceFilename =~ /\\.(audionote|audiomd)\\.md$/ && !editorReadonly"
      }
    ],
    "keybindings": [
      {
        "command": "audio-md.seekBackward",
        "key": "ctrl+alt+j",
        "when": "(editorTextFocus && resourceFilename =~ /\\.(audionote|audiomd)\\.md$/) || (activeWebviewPanelId == 'audio-md.viewer')"
      },
      {
        "command": "audio-md.togglePlayback",
        "key": "ctrl+alt+k",
        "when": "(editorTextFocus && resourceFilename =~ /\\.(audionote|audiomd)\\.md$/) || (activeWebviewPanelId == 'audio-md.viewer')"
      },
      {
        "command": "audio-md.seekForward",
        "key": "ctrl+alt+l",
        "when": "(editorTextFocus && resourceFilename =~ /\\.(audionote|audiomd)\\.md$/) || (activeWebviewPanelId == 'audio-md.viewer')"
      },
      {
        "command": "audio-md.insertCurrentTimestamp",
        "key": "ctrl+alt+i",
        "when": "(editorTextFocus && resourceFilename =~ /\\.(audionote|audiomd)\\.md$/) || (activeWebviewPanelId == 'audio-md.viewer')"
      }
    ],
    "configuration": {
      "title": "AudioMD",
      "properties": {
        "audio-md.volume": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "Playback volume of the AudioMD preview (0 to 1). Updated when you move the volume slider."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "audio-md.openPreview",
          "when": "resourceFilename =~ /\\.(audionote|audio-md)\\.md$/",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "vscode:prepublish": "pnpm run build",
    "watch": "node esbuild.mjs --watch",
    "serve": "python3 -m http.server 7890",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.116.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "dompurify": "^3.4.2",
    "effect": "^3.3.0",
    "marked": "^18.0.2",
    "preact": "^10.29.1",
    "yaml": "^2.9.0"
  }
}
