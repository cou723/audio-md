{
  "name": "audionote",
  "displayName": "Audio Note",
  "description": "View and edit .audionote.md files with synchronized audio waveform",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "audionote.viewer",
        "displayName": "Audio Note Viewer",
        "selector": [
          { "filenamePattern": "*.audionote.md" }
        ],
        "priority": "default"
      }
    ]
  },
  "activationEvents": [
    "onCustomEditor:audionote.viewer"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "effect": "^3.0.0",
    "@effect/schema": "^0.68.0"
  }
}
