{
  "name": "soundstamp",
  "displayName": "SoundStamp",
  "description": "View .audionote.md and .soundstamp.md files with synchronized audio playback",
  "version": "0.1.0",
  "publisher": "coucha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cou723/soundstamp.git"
  },
  "bugs": {
    "url": "https://github.com/cou723/soundstamp/issues"
  },
  "homepage": "https://github.com/cou723/soundstamp#readme",
  "keywords": [
    "audio",
    "markdown",
    "waveform",
    "transcription",
    "note"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "soundstamp.openPreview",
        "title": "Open SoundStamp Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "soundstamp.openPreview",
          "when": "resourceFilename =~ /\\.(audionote|soundstamp)\\.md$/",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "serve": "python3 -m http.server 7890",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.2",
    "effect": "^3.3.0",
    "marked": "^18.0.2",
    "preact": "^10.29.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
