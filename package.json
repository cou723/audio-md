{
  "name": "audionote",
  "displayName": "Audio Note Viewer",
  "description": "View .audionote.md files with synchronized audio playback",
  "version": "0.1.0",
  "publisher": "coucha",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "audionote.openPreview",
        "title": "Open Audio Note Preview",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "audionote.openPreview",
          "when": "resourceFilename =~ /\\.audionote\\.md$/",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "serve": "python3 -m http.server 7890",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "dompurify": "^3.4.2",
    "effect": "^3.3.0",
    "marked": "^18.0.2",
    "preact": "^10.29.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
